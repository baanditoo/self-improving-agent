# Copy to .env. Never commit .env. Live trading stays off unless LIVE_TRADING=true.
GMGN_API_KEY=
GMGN_PRIVATE_KEY=
GMGN_HOST=https://openapi.gmgn.ai
WALLET_ADDRESS=
LIVE_TRADING=false
TRADE_SIZE_SOL=0.10
MAX_POSITIONS=4
ENTRY_THRESHOLD=64
INITIAL_SCALE_MODE=cost_basis
TAKE_INITIAL_MULT=2.0
STOP_LOSS_PCT=0.22
TRAIL_ARM_MULT=2.4
TRAIL_GIVEBACK_PCT=0.22
MAX_DAILY_DD_PCT=25
MIN_LIQ_USD=8000
MAX_TOP10_PCT=0.40
PAPER_EQUITY_SOL=10
PAPER_EQUITY_USD=500
MAX_BUY_USD=10
PUMPFUN_BASE_URL=https://frontend-api-v3.pump.fun
PUMPFUN_BEARER=
STONKFUN_BASE_URL=https://www.stonkfun.xyz/api/public/v1
STONKS_API_KEY=
BITQUERY_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
LOG_LEVEL=INFO
# Optional knobs (defaults shown).
MAX_HOLD_NO_MOVE_MIN=60
MAX_PRICE_IMPACT_PCT=0.10
FLAT_ON_EXIT=false
LOOP_INTERVAL_SEC=20
REQUIRE_RENOUNCED_MINT=true
REQUIRE_RENOUNCED_FREEZE=true
ALLOW_DEV_HOLD=false
PAPER_SLIPPAGE_PCT=0.01
SOL_PRICE_USD=150
